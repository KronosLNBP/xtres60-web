# XTres60 — sitio estático
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Rutas del sitio anterior (React) hacia las secciones nuevas
  RewriteRule ^servicios/?$ /#servicios [R=301,NE,L]
  RewriteRule ^contacto/?$ /#contacto [R=301,NE,L]
  RewriteRule ^proyectos/?$ /#casos [R=301,NE,L]
</IfModule>
